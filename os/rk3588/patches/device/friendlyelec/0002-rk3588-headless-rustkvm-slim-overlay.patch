@@ -0,0 +1,22 @@
+#!/bin/bash
+# RustKVM: last overlay step. Drops what device/rockchip and the rockchip
+# fs-overlay install unconditionally but a headless KVM never uses.
+set -eu
+ROOTFS_DIR=$1
+
+(cd ${ROOTFS_DIR} && {
+	# Prebuilt tools: gdb, four perf builds, adb, frecon, benchmarks.
+	rm -rf usr/local/bin
+
+	# Fonts from device/rockchip/common/fonts (no display stack).
+	rm -rf usr/share/fonts
+
+	# Demo media in /oem and /userdata.
+	find oem userdata -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
+
+	# PulseAudio leftovers from board/rockchip/rk3588/fs-overlay.
+	rm -rf usr/share/pulseaudio etc/udev/rules.d/90-pulseaudio-rockchip.rules
+
+	# rkscript's USB gadget service: rustkvm_app owns configfs.
+	rm -f etc/init.d/S50usbdevice.sh etc/init.d/K50usbdevice.sh lib/udev/rules.d/61-usbdevice.rules
+})
