diff --git a/package/uvc-gadget/0003-lib-accept-continuous-frame-intervals.patch b/package/uvc-gadget/0003-lib-accept-continuous-frame-intervals.patch
new file mode 100644
index 0000000000..5b19aa4e02
--- /dev/null
+++ b/package/uvc-gadget/0003-lib-accept-continuous-frame-intervals.patch
@@ -0,0 +1,29 @@
+From: rustkvm <noreply@anthropic.com>
+Date: Fri, 20 Jun 2026 00:00:00 +0000
+Subject: [PATCH] lib: accept CONTINUOUS frame intervals from the V4L2 source
+
+v4l2loopback (used to bridge a control-end browser camera into the f_uvc
+gadget for operator-camera passthrough) reports
+V4L2_FRMIVAL_TYPE_CONTINUOUS frame intervals. The original enumerator
+only accepted DISCRETE and STEPWISE and returned -EINVAL otherwise, so
+uvc-gadget aborted with "unable to enumerate formats" and the camera
+could never stream. CONTINUOUS shares the STEPWISE union layout; accept
+both as a range.
+
+Signed-off-by: rustkvm <noreply@anthropic.com>
+--- a/lib/v4l2.c
++++ b/lib/v4l2.c
+@@ -114,7 +114,13 @@
+ 			ival->step.denominator = 1;
+ 			break;
+ 
++		case V4L2_FRMIVAL_TYPE_CONTINUOUS:
+ 		case V4L2_FRMIVAL_TYPE_STEPWISE:
++			/* v4l2loopback reports CONTINUOUS (and some sources
++			 * STEPWISE) frame intervals; the union layout is the same
++			 * as STEPWISE, so accept both as a range instead of
++			 * bailing out — otherwise browser-camera passthrough via
++			 * the loopback can never enumerate. */
+ 			ival->min = ivalenum.stepwise.min;
+ 			ival->max = ivalenum.stepwise.max;
+ 			ival->step = ivalenum.stepwise.step;
diff --git a/package/uvc-gadget/uvc-gadget.mk b/package/uvc-gadget/uvc-gadget.mk
index 52ca51a557..6c6e98be2e 100644
--- a/package/uvc-gadget/uvc-gadget.mk
+++ b/package/uvc-gadget/uvc-gadget.mk
@@ -11,6 +11,10 @@ UVC_GADGET_LICENSE = LGPL 2.1+
 
 UVC_GADGET_DEPENDENCIES = jpeg
 
+# Upstream forces werror=true in meson.build, which breaks the build with
+# recent GCC + _FORTIFY_SOURCE (unused-result on read()/chdir()).
+UVC_GADGET_CONF_OPTS += -Dwerror=false
+
 UVC_GADGET_STATIC = $(BR2_PACKAGE_UVC_GADGET_STATIC)
 ifeq ($(UVC_GADGET_STATIC),y)
 UVC_GADGET_CFLAGS += -static
